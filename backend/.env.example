# 环境配置（development 默认轻量精排；production/staging 默认 Cross-Encoder）
ENVIRONMENT=development

# LLM 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=enterprise_agent

# Redis（P3 澄清 pending + P4 LangGraph checkpoint，多实例部署时配置）
# REDIS_URL=redis://localhost:6379/0
# CLARIFICATION_STATE_BACKEND=auto
# CLARIFICATION_STATE_TTL_SECONDS=86400
# GRAPH_CHECKPOINT_BACKEND=auto

# Chroma 配置
CHROMA_HOST=localhost
CHROMA_PORT=8000

# JWT 配置
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 监控配置
LOG_LEVEL=INFO
ENABLE_TRACING=true
TOKEN_BUDGET_WARNING_THRESHOLD=0.8
TOKEN_BUDGET_CRITICAL_THRESHOLD=0.95

# RAG 精排（可选，留空则随 ENVIRONMENT 自动选择）
# development → lexical（jieba，无 PyTorch）
# production / staging → cross_encoder（BGE，需 sentence-transformers）
# RAG_RERANKER_BACKEND=lexical
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANKER_MAX_DOC_CHARS=1500
